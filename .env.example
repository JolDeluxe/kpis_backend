NODE_ENV=development
PORT=3005

# Base de datos SQLite persistente (dentro del repositorio backend)
DATABASE_URL=file:./data/kpi.db
DATABASE_PATH=./data/kpi.db

# Origen principal del frontend (desarrollo local o Netlify)
FRONTEND_ORIGIN=http://localhost:5173
# Orígenes adicionales permitidos separados por coma (ej. Netlify, tunnels, etc.)
FRONTEND_ORIGINS=https://kpi-mbc.netlify.app

# Autenticación, JWT y Cookies
JWT_SECRET=change_this_with_at_least_32_random_characters
COOKIE_NAME=kpi_access
REFRESH_COOKIE_NAME=kpi_refresh
CREDENTIALS_ENCRYPTION_KEY=

# Clave compartida para que el sync-agent realice POST /api/sync/kpis
SYNC_API_KEY=change_this_with_a_secure_sync_key

# Sincronización interna (Desactivada: el sync-agent integrado es la única fuente de ingesta)
KPI_SOURCE=disabled
BOOTSTRAP_SEED=false

# Watcher del Sync-Agent (Servidor Windows)
WATCH_PATH=\\GC-SRV-ARCHI-01.gc.com\USUARIOSMBC\AUDITOR INTERNO\PRIVADO\5 Isaac\KPI_JEFATURAS\KPI_Jefaturas.csv
# WATCH_PATH=H:\AUDITOR INTERNO\PRIVADO\5 Isaac\KPI_JEFATURAS\KPI_Jefaturas.csv
API_URL=http://localhost:3005
CHECK_INTERVAL_MS=60000
