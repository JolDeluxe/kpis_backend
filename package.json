{
  "name": "@kpi-jefaturas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:sync": "tsx watch src/sync-agent/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/index.js",
    "start:prod": "node dist/scripts/start-production.js",
    "start:sync": "node dist/src/sync-agent/index.js",
    "prisma:migrate": "tsx scripts/setup-sqlite.ts && prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:csv": "tsx scripts/import-initial-csv.ts",
    "ver:credenciales": "tsx scripts/ver-credenciales.ts",
    "db:backup": "tsx scripts/backup-sqlite.ts",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^4.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^174.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.2.2",
    "prisma": "^6.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
